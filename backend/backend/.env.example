# =================================================================
# ULTRON AI SAFETY ASSISTANT - CONFIGURATION & CREDENTIALS
# =================================================================

# Server Port
PORT=5000

# -----------------------------------------------------------------
# 1. TWILIO REAL-TIME CALLS & SMS (Voice API)
# -----------------------------------------------------------------
# Get your free or live API keys at: https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# -----------------------------------------------------------------
# 2. REAL-TIME LOCATION EMAIL DISPATCH (Nodemailer SMTP)
# -----------------------------------------------------------------
# For Gmail, generate an App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password_here
EMAIL_FROM="ULTRON Emergency Dispatch" <emergency@ultron.ai>

# -----------------------------------------------------------------
# 3. GOOGLE GEMINI AI (Optional for Open-Ended Conversational Safety)
# -----------------------------------------------------------------
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
